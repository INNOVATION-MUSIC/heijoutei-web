# このファイルをコピーして .env.local を作成し、値を設定してください。
#   cp .env.example .env.local

# ===== Supabase（CMS 管理画面・DB 連携）=====
# プロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service Role キーはサーバー専用。絶対にクライアントへ公開しないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== テイクアウト注文メール送信（Nodemailer / SMTP）設定 =====

# SMTP サーバー
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# secure: 465(SSL)なら true、587(STARTTLS)なら false（未指定でもポートから自動判定）
SMTP_SECURE=false
SMTP_USER=your-smtp-user
# 注意: パスワードに $ が含まれる場合は \$ とエスケープしてください
#       （Next.js の env は $xxx を変数展開するため。例: a$b1c → a\$b1c）
SMTP_PASS=your-smtp-password

# 送信元アドレス（例: 焼肉平壌亭 <noreply@heijohtei.jp>）。未指定時は SMTP_USER を使用
MAIL_FROM=焼肉平壌亭 <noreply@example.com>

# 店舗・管理者の注文通知先アドレス（未指定の場合は店舗通知をスキップし、お客様控えのみ送信）
ORDER_NOTIFY_TO=order@example.com

# お問い合わせ(/contact)の通知先アドレス（未指定時は ORDER_NOTIFY_TO を使用。SMTP_* はテイクアウトと共用）
CONTACT_NOTIFY_TO=contact@example.com
