{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "heijoutei-web",
  "compatibility_date": "2025-03-25",
  // nodejs_compat: Next.js のサーバ実行に必要（Node 互換 API）
  "compatibility_flags": ["nodejs_compat"],
  // OpenNext が生成する静的アセット（_next/static など）を配信
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // 確認環境（`--env staging` でデプロイ）。本番の設定（上記トップレベル）には影響しない。
  // NEXT_PUBLIC_SITE_URL=https://staging.heijyotei.com と確認用 Supabase の NEXT_PUBLIC_* はビルド時に渡すこと。
  "env": {
    "staging": {
      "name": "heijoutei-web-staging",
      "routes": [{ "pattern": "staging.heijyotei.com", "custom_domain": true }],
      "vars": {
        "MAIL_REDIRECT_TO": "motoki.s@innovation-music.com"
      },
      "observability": {
        "enabled": true
      }
    }
  }
  // ISR（revalidate=60）をインスタンス跨ぎで永続化する場合は R2 を追加し、
  // open-next.config.ts の incrementalCache に r2IncrementalCache を設定する。
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "heijoutei-web-cache" }
  // ]
}
